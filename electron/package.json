{
  "name": "kermes-defterim",
  "productName": "Kermes Defterim",
  "version": "1.0.1",
  "description": "Kermes Defterim masaüstü uygulaması",
  "main": "main.js",
  "author": "Kermes Defterim",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kermesdefterim.desktop",
    "productName": "Kermes Defterim",
    "artifactName": "Kermes-Defterim-Kurulum.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kermes Defterim"
    }
  }
}
